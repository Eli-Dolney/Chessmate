{
  "name": "chessmate",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && node scripts/prepare-assets.mjs && vite build",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:openings": "node scripts/build-openings.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stockfish": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.56.0",
    "fake-indexeddb": "^6.2.0"
  },
  "description": "Your free, local chess companion. Explore moves, understand plans, and practice with an offline coach.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eli-Dolney/Chessmate.git"
  }
}
